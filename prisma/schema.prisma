// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "sqlite"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    mtgPagePublic        Boolean   @default(false)
    mtgPageName          String?
    diceRollerStats              String?
    diceRollerActionSets         String?
    diceRollerSelectedActionSet  String?
    diceRollerPhysics            String?
    diceRollerVisuals            String?
    accounts             Account[]
    sessions             Session[]
    decks                    Deck[]
    hikingMapData           HikingMapData[]
    deckListImportPromptSeen Boolean @default(false)
}

model HikingMapData {
  id        String   @id @default(cuid())
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name                     String
  waypoints                String
  routeCoords              String
  routeSegments            String
  routeWaypointDistancesKm String
  distanceKm               Float

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Deck {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name                String?
  colorId             String?
  // true when this deck is the active mtg-complete selection for its colorId
  isActiveSelection   Boolean @default(false)

  commanderScryfallId String?
  commanderName       String?
  commanderTypeLine   String?
  commanderImage      String?
  commanderArtCrop    String?
  commanderPreferredPrintId        String?
  commanderPreferredPrintImage     String?
  commanderPreferredPrintArt       String?
  commanderPreferredPrintBackImage String?
  commanderPreferredPrintBackArt   String?

  partnerScryfallId   String?
  partnerName         String?
  partnerTypeLine     String?
  partnerImage        String?
  partnerArtCrop      String?
  partnerType         String?
  partnerPreferredPrintId          String?
  partnerPreferredPrintImage       String?
  partnerPreferredPrintArt         String?
  partnerPreferredPrintBackImage   String?
  partnerPreferredPrintBackArt     String?

  companionScryfallId String?
  companionName       String?
  companionTypeLine   String?
  companionImage      String?
  companionArtCrop    String?
  companionPreferredPrintId        String?
  companionPreferredPrintImage     String?
  companionPreferredPrintArt       String?
  companionPreferredPrintBackImage String?
  companionPreferredPrintBackArt   String?

  bracket             String?
  tags                String  @default("[]")
  favoriteTag         String?
  archetype           String?
  deckListUrl         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}
